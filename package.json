{
  "name": "loopcasts-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"npm:api\"",
    "dev:web": "vite",
    "api": "node --env-file=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "data:clean": "python -X utf8 scripts/clean_data.py",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "db:seed": "docker compose exec -T db psql -U loopcasts -d loopcasts -f /db/seed/load.sql",
    "db:reset": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.5",
    "vite": "^5.4.8"
  }
}
