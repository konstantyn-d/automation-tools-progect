# Copy to .env and put your own random values in it. .env is in .gitignore: secrets never go into git.

# ---- Postgres ----
POSTGRES_USER=loopcasts
POSTGRES_PASSWORD=change-me

# ---- n8n ----
# Encrypts the credentials stored inside n8n. Make it once, never change it afterwards.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
