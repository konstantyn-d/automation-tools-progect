# Copy to .env and fill in. .env is in .gitignore: secrets never go into git.

# ---- Postgres (docker compose) ----
POSTGRES_USER=loopcasts
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://loopcasts:change-me@localhost:5432/loopcasts

# ---- n8n ----
# Encrypts the credentials stored inside n8n. Generate once, never change it afterwards.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ---- API ----
API_PORT=3001
# Shared secret n8n sends in the X-Internal-Key header when it calls /internal/* endpoints.
INTERNAL_API_KEY=change-me
# Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173

# ---- E-mail (local: Mailpit catches everything) ----
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=LoopCasts <hello@loopcasts.example>

# ---- Frontend ----
# Leave empty to use the local API through the Vite proxy (/api).
VITE_API_URL=
