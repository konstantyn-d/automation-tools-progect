# n8n webhook URLs. Leave empty to run the frontend on mock data.
# No secrets here: n8n credentials live in n8n, not in the frontend.
VITE_N8N_BASE_URL=
VITE_WH_ORDER_CREATE=/webhook/order/create
VITE_WH_VAT_CHECK=/webhook/vat/check
VITE_WH_PROMO_CHECK=/webhook/promo/check
VITE_WH_ORDER_STATUS=/webhook/order/status
VITE_WH_AUTH_LOGIN=/webhook/auth/login
VITE_WH_AUTH_SIGNUP=/webhook/auth/signup
VITE_WH_PASSWORD_RESET_REQUEST=/webhook/auth/reset-request
VITE_WH_PASSWORD_RESET_CONFIRM=/webhook/auth/reset-confirm
VITE_WH_ACCOUNT=/webhook/account
VITE_WH_BILLING_UPDATE=/webhook/account/billing
VITE_WH_SEATS_UPDATE=/webhook/account/seats
VITE_WH_RENEW=/webhook/subscription/renew
VITE_WH_SUPPORT_CREATE=/webhook/support/create
VITE_WH_NEWSLETTER_SUBSCRIBE=/webhook/newsletter/subscribe
VITE_WH_NEWSLETTER_CONFIRM=/webhook/newsletter/confirm
VITE_WH_NEWSLETTER_UNSUBSCRIBE=/webhook/newsletter/unsubscribe
